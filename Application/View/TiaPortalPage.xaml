<UserControl x:Class="VIBN_Tools.Application.View.TiaPortalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="TIA Portal" Style="{StaticResource H1Style}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Orientation="Horizontal">
            <ComboBox Width="140"
                      ItemsSource="{Binding InstalledVersions}"
                      SelectedItem="{Binding SelectedVersion}" />
            <Button MinWidth="170"
                    Margin="8,0,0,0"
                    Content="Verbinden und öffnen"
                    Command="{Binding ConnectCommand}" />
            <ComboBox Width="300"
                      Margin="24,0,0,0"
                      ItemsSource="{Binding Plcs}"
                      SelectedItem="{Binding SelectedPlc}"
                      DisplayMemberPath="Name" />
            <Button MinWidth="120"
                    Margin="8,0,0,0"
                    Content="PLC auswählen"
                    Command="{Binding SelectPlcCommand}" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Projektübersicht">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Programmbausteine und Datentypen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="150"
                                Content="Bausteine laden"
                                Command="{Binding LoadBlocksCommand}" />
                        <Button MinWidth="150"
                                Margin="8,0,0,0"
                                Content="Datentypen laden"
                                Command="{Binding LoadDataTypesCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProgramItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding FolderPath, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Simulationsachsen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            MinWidth="170"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Content="Achsen konfigurieren"
                            Command="{Binding ConfigureAxesCommand}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Axes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Achse" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding TechnologyType, Mode=OneWay}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            MinWidth="150"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Content="Projekt speichern"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </GroupBox>
        </Grid>
            </TabItem>

            <TabItem Header="Hardware-Konfiguration">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left"
                                MinWidth="220"
                                Content="Hardware aus TIA lesen"
                                Command="{Binding LoadHardwareCommand}" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF666666"
                                   Text="Die Byteadressen werden nur gelesen. Für die Zuordnung zu Special Devices den Reiter „Special Devices“ verwenden." />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding HardwareModules}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              RowHeight="30"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceName, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot, Mode=OneWay}" Width="70" />
                            <DataGridTextColumn Header="Modul" Binding="{Binding ModuleName, Mode=OneWay}" Width="220" />
                            <DataGridTextColumn Header="Modultyp" Binding="{Binding ModuleType, Mode=OneWay}" Width="180" />
                            <DataGridTextColumn Header="Typkennung" Binding="{Binding TypeIdentifier, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Firmware" Binding="{Binding FirmwareVersion, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="E-Adresse" Binding="{Binding InputAddressRange, Mode=OneWay}" Width="105" />
                            <DataGridTextColumn Header="E-Länge (Byte)" Binding="{Binding InputLength, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="A-Adresse" Binding="{Binding OutputAddressRange, Mode=OneWay}" Width="105" />
                            <DataGridTextColumn Header="A-Länge (Byte)" Binding="{Binding OutputLength, Mode=OneWay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="ViCo-Bibliothek">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Importordner" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="8,4" Text="{Binding LibraryPath}" />
                    <Button Grid.Row="0" Grid.Column="2" MinWidth="110" Content="Durchsuchen" Command="{Binding BrowseImportCommand}" />

                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              Margin="8,8"
                              Content="Achsen konfigurieren und AxisDB/AxisFC erzeugen"
                              IsChecked="{Binding ConfigureAxesDuringImport}" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            MinWidth="150"
                            Content="Bibliothek importieren"
                            Command="{Binding ImportLibraryCommand}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Exportordner" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,4" Text="{Binding ExportPath}" />
                    <Button Grid.Row="2" Grid.Column="2" MinWidth="110" Content="Durchsuchen" Command="{Binding BrowseExportCommand}" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,16,8,0">
                        <TextBlock Text="TIA-Bibliotheksordner" />
                        <TextBox Margin="0,4,0,12" Text="{Binding LibraryName}" />
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            MinWidth="150"
                            Margin="0,16,0,0"
                            VerticalAlignment="Top"
                            Content="Bibliothek exportieren"
                            Command="{Binding ExportLibraryCommand}" />
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="6"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
