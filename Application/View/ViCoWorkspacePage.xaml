<UserControl x:Class="VIBN_Tools.Application.View.ViCoWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VIBN_Tools.Application.View">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock MinWidth="110" Text="{Binding}" TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <TabControl Margin="8" HorizontalContentAlignment="Center">
        <TabItem Header="Übersicht &amp; Verbindung">
            <TabControl Margin="4" HorizontalContentAlignment="Center">
                <TabItem Header="PC-/Projektsuche">
                    <local:ViCoSearchPage />
                </TabItem>
                <TabItem Header="Projekte &amp; Favoriten">
                    <local:ViCoPage />
                </TabItem>
            </TabControl>
        </TabItem>
        <TabItem Header="Transfer">
            <local:ViCoCopyPage />
        </TabItem>
        <TabItem Header="TIA Portal">
            <local:TiaPortalPage />
        </TabItem>
        <TabItem Header="Verwaltung">
            <local:ViCoAdministrationPage />
        </TabItem>
    </TabControl>
</UserControl>
