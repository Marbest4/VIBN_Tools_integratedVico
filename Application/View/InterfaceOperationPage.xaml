<UserControl x:Class="VIBN_Tools.Application.View.InterfaceOperationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ux="http://Grob.com/wpf.ux"
             xmlns:uxb="http://Grob.com/wpf.ux.behaviors"
             xmlns:g="clr-namespace:VIBN_Tools.GlobalClasses"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"   
             xmlns:local="clr-namespace:VIBN_Tools.Application.View"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1600">

    <UserControl.DataContext>
        <vm:InterfaceOperationPageVM/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding ReloadFeeInterfaces}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary  Source="pack://application:,,,/Grob.UX;component/Styles/ScrollBarStyles.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!--Datatemplates for different option styles-->
            <DataTemplate x:Key="TextBlockContentTemplate">
                <TextBlock Text="{Binding ValueObject}" Style="{StaticResource TextRobotoRegularStyle}"/>
            </DataTemplate>

            <DataTemplate x:Key="TextBoxContentTemplate">
                <ux:TextBox Text="{Binding ValueObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <DataTemplate x:Key="ComboBoxContentTemplate">
                <ux:ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding ValueObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Select Item" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <DataTemplate x:Key="CheckBoxContentTemplate">
                <ux:CheckBox IsChecked="{Binding ValueObject, Mode=TwoWay}" Style="{StaticResource CheckBoxSmallStyle}" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <g:ViewElementTemplateSelector x:Key="TemplateSelectorViewElement" 
                               TextBlockTemplate="{StaticResource TextBlockContentTemplate}"
                               TextBoxTemplate="{StaticResource TextBoxContentTemplate}"
                               ComboBoxTemplate="{StaticResource ComboBoxContentTemplate}"
                               CheckBoxTemplate="{StaticResource CheckBoxContentTemplate}"/>

            <g:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--Connect Interfaces-->
        <GroupBox Grid.Row="0" Grid.Column="0" Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="Connect Interfaces"/>
            </GroupBox.Header>

            <Grid >
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!--Grid for Interface 1 settings-->
                <GroupBox Grid.Row="0" Margin="5">
                    <GroupBox.Header>
                        <TextBlock Text="Interface 1 - Settings" Style="{StaticResource DescriptionStyle}"/>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="Select Interface:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:ComboBox Grid.Row="0" Grid.Column="1" Margin="5" ItemsSource="{Binding InterfacesView1}" DisplayMemberPath="Name" SelectedItem="{Binding Interface1.SelectedInterface}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Starting Byte:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" uxb:ArithmeticCalculation.Enabled="True" Text="{Binding Interface1.StartByte}"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="Byte Count:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" uxb:ArithmeticCalculation.Enabled="True" Text="{Binding Interface1.ByteCount}"/>


                        <ux:CheckBox Grid.Row="3" Grid.Column="0" Margin="5" Style="{StaticResource CheckBoxSmallStyle}" IsChecked="{Binding Interface1.UseDbAddressing}" 
                                     Visibility="{Binding Interface1.CanUseDbAdressing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Use DB" Style="{StaticResource TextRobotoRegularStyle}"/>
                        </ux:CheckBox>

                        <Grid Grid.Row="3" Grid.Column="1" Visibility="{Binding Interface1.CanUseDbAdressing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="5" Text="Out-DB:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                            <ux:TextBox Grid.Column="1" Margin="5" Width="100" Height="30" HorizontalAlignment="Left" Text="{Binding Interface1.DbOutNumber}" uxb:ArithmeticCalculation.Enabled="True"
                                        IsEnabled="{Binding Interface1.UseDbAddressing}"/>

                            <TextBlock Grid.Column="2" Margin="5" Text="In-DB:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                            <ux:TextBox Grid.Column="3" Margin="5" Width="100" Height="30" HorizontalAlignment="Left" Text="{Binding Interface1.DbInNumber}" uxb:ArithmeticCalculation.Enabled="True"
                                        IsEnabled="{Binding Interface1.UseDbAddressing}"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="Mode:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:ComboBox Grid.Row="4" Grid.Column="1" Margin="5" Height="40" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding InterfaceConnectionModes}" SelectedItem="{Binding Interface1.SelectedMode}"/>

                    </Grid>
                </GroupBox>


                <!--Grid for Interface 2 settings-->
                <GroupBox Grid.Row="1" Margin="5">
                    <GroupBox.Header>
                        <TextBlock Text="Interface 2 - Settings" Style="{StaticResource DescriptionStyle}"/>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="Select Interface:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:ComboBox Grid.Row="0" Grid.Column="1" Margin="5" ItemsSource="{Binding InterfacesView2}" DisplayMemberPath="Name" SelectedItem="{Binding Interface2.SelectedInterface}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Starting Byte:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" uxb:ArithmeticCalculation.Enabled="True" Text="{Binding Interface2.StartByte}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="Byte Count:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" uxb:ArithmeticCalculation.Enabled="True" Text="{Binding Interface2.ByteCount}"/>


                        <ux:CheckBox Grid.Row="3" Grid.Column="0" Margin="5" Style="{StaticResource CheckBoxSmallStyle}" IsChecked="{Binding Interface2.UseDbAddressing}" 
                 Visibility="{Binding Interface2.CanUseDbAdressing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Use DB" Style="{StaticResource TextRobotoRegularStyle}"/>
                        </ux:CheckBox>

                        <Grid Grid.Row="3" Grid.Column="1" Visibility="{Binding Interface2.CanUseDbAdressing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="5" Text="Out-DB:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                            <ux:TextBox Grid.Column="1" Margin="5" Width="100" Height="30" HorizontalAlignment="Left" Text="{Binding Interface2.DbOutNumber}" uxb:ArithmeticCalculation.Enabled="True"
                                        IsEnabled="{Binding Interface2.UseDbAddressing}"/>

                            <TextBlock Grid.Column="2" Margin="5" Text="In-DB:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                            <ux:TextBox Grid.Column="3" Margin="5" Width="100" Height="30" HorizontalAlignment="Left" Text="{Binding Interface2.DbInNumber}" uxb:ArithmeticCalculation.Enabled="True"
                                        IsEnabled="{Binding Interface2.UseDbAddressing}"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="Mode:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                        <ux:ComboBox Grid.Row="4" Grid.Column="1" Margin="5" Height="40" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding InterfaceConnectionModes}" SelectedItem="{Binding Interface2.SelectedMode}"/>

                    </Grid>
                </GroupBox>

                <!--Buttons Reload and Connect-->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <ux:Button Grid.Column="0" Margin="5" ux:Icon.Kind="Restart" Command="{Binding ReloadFeeInterfaces}" IsBusy="{Binding IsBusyReloadInterfaces}"/>
                    <ux:Button Grid.Column="1" Margin="5" Content="Connect Interfaces" Command="{Binding ConnectInterfaces}" IsEnabled="{Binding CanConnetInterfaces}"/>

                </Grid>

                
            </Grid>        

        </GroupBox>


        <!--Merge Interfaces-->
        <GroupBox Grid.Row="0" Grid.Column="1" Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="Merge Interfaces"/>
            </GroupBox.Header>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Margin="5" Text="Filter:" Style="{StaticResource TextRobotoRegularStyle}" VerticalAlignment="Center"/>
                    <ux:TextBox Margin="10,5,50,5" Watermark="Filter text" Text="{Binding TextFilterSignals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250" />

                    <ux:Button Margin="5" Content="Select All" DebounceInterval="150" MinWidth="120" Command="{Binding SelectVisibleSignals}" />
                    <ux:Button Margin="5" Content="Deselect All" DebounceInterval="150" MinWidth="120" Command="{Binding DeselectVisibleSignals}" />

                    <ux:Button Margin="5" DebounceInterval="150" ux:Icon.Kind="Restart" Command="{Binding ReloadFeeSignals}" IsBusy="{Binding IsBusyUpdatingFeeData}"/>
                </StackPanel>

                <DataGrid Grid.Row="1" Margin="5" ItemsSource="{Binding SignalsView}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" >
                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />

                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Address / Path" Binding="{Binding Address}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" IsReadOnly="True" />
                        <DataGridTextColumn Header="IO Type" Binding="{Binding IOTypeString}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Usage" Binding="{Binding UsageString}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Interface" Binding="{Binding ParentInterface.Name}" IsReadOnly="True" />
                    </DataGrid.Columns>                

                </DataGrid>

                <ux:Button Grid.Row="2" Margin="5" Content="Merge Signals to new Interface" Command="{Binding MergeSignalsToInterface}" DebounceInterval="150"/>



            </Grid>
        </GroupBox>
        


        <!--Status of Merge-->
        <GroupBox Grid.Row="0" Grid.Column="2" Margin="10" Visibility="Collapsed">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="Status information"/>
            </GroupBox.Header>

            <StackPanel Orientation="Vertical">

                <ItemsControl ItemsSource="{Binding XXX}" Grid.IsSharedSizeScope="True" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="5" Text="{Binding Label}" Style="{StaticResource TextRobotoLightStyle}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource TemplateSelectorViewElement}"/>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </StackPanel>
            
        </GroupBox>


    </Grid>
</UserControl>
