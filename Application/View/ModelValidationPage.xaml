    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ux:Button Grid.Column="0" Margin="5" Content="Update Objects" Command="{Binding UpdateFeeObjectData}" IsBusy="{Binding IsBusyUpdatingFeeData}"/>
            <ux:Button Grid.Column="3" Margin="50,5,5,5" ux:Icon.Kind="Minimize" Command="{Binding CollapseAll}"/>
            <ux:Button Grid.Column="4" Margin="5" ux:Icon.Kind="Maximize" Command="{Binding ExpandAll}"/>
            <TextBlock Grid.Column="5" Margin="50,5,5,5" Text="Filter:" Style="{StaticResource TextRobotoLightStyle}" VerticalAlignment="Center"/>
            <ux:TextBox Grid.Column="6" Margin="5" Width="350" Text="{Binding DataContext.FilterText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <TabControl Grid.Row="1" Margin="5" ItemsSource="{Binding ValidationGroups}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource InplaceTabItemSmallStyle}">
                    <Setter Property="Header" Value="{Binding GroupName}" />
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ItemsTemplateSelector}" HorizontalAlignment="Left"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
