<Window x:Class="VIBN_Tools.Application.View.NoiseFilterEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noise-Filter bearbeiten"
        Height="441" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0 4 0 4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BADWORD LISTE -->
        <GroupBox Header="BadWords (werden beim Training gefiltert)">
            <StackPanel>
                <ListBox x:Name="BadWordList"
                         Height="260"
                         ItemsSource="{Binding BadWords}"
                         Margin="0 0 0 8"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewBadWordBox" Width="200"/>
                    <Button Content="Hinzufügen"
                            Width="100"
                            Click="AddBadWord_Click"/>
                </StackPanel>

                <Button Content="Ausgewähltes Wort löschen"
                        Width="200"
                        Click="DeleteBadWord_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- BUTTONLEISTE -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" Width="100" Click="Save_Click"/>
            <Button Content="Abbrechen" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>