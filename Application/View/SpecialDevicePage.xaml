<UserControl x:Class="VIBN_Tools.Application.View.SpecialDevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="285" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="330" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Special Devices" />
            <TextBlock Margin="0,4,0,0" Foreground="#FF666666" Text="Manuelle Geräte und TIA-Hardware werden auf einer Seite vorbereitet. Erst die Warteschlange erzeugt Geräte in FEE." TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" MinWidth="570" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Gerät manuell hinzufügen" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Hersteller" />
                    <ComboBox Grid.Row="0" Grid.Column="1" MinHeight="34" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer}" />
                    <TextBlock Grid.Row="1" Margin="0,9,0,0" VerticalAlignment="Center" Text="Gerätetyp / Logik" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDevice}" />
                    <TextBlock Grid.Row="2" Margin="0,9,0,0" VerticalAlignment="Center" Text="Robotertyp" Visibility="{Binding ShowRobotType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" ItemsSource="{Binding RobotTypes}" SelectedItem="{Binding SelectedRobotType}" Visibility="{Binding ShowRobotType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Row="3" Margin="0,9,0,0" VerticalAlignment="Center" Text="Präfix" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" MinHeight="34" IsEnabled="{Binding IsEnabledDevicePrefix}" Text="{Binding DevicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Margin="0,9,0,0" VerticalAlignment="Center" Text="Byteadressen" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,9,0,0" IsEnabled="{Binding IsEnabledDeviceAddress}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Eingang:" />
                        <TextBox Grid.Column="1" Margin="6,0,15,0" MinHeight="34" Text="{Binding DeviceAddressInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Ausgang:" />
                        <TextBox Grid.Column="3" Margin="6,0,0,0" MinHeight="34" Text="{Binding DeviceAddressOutput, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" MinHeight="38" Content="Gerät in Warteschlange übernehmen" Command="{Binding AddSpecialDeviceCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Warteschlange / in FEE erzeugen" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding SpecialDevices}" SelectedIndex="{Binding SelectedDeviceIndex}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="30" ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Präfix" Binding="{Binding DevicePrefix, Mode=OneWay}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Hersteller" Binding="{Binding DeviceManufacturer, Mode=OneWay}" Width="120" />
                            <DataGridTextColumn Header="Logik" Binding="{Binding DeviceLogicObject.LogicDefinitionName, Mode=OneWay}" Width="210" />
                            <DataGridTextColumn Header="E-Byte" Binding="{Binding DeviceAddresses.Input, Mode=OneWay}" Width="75" />
                            <DataGridTextColumn Header="A-Byte" Binding="{Binding DeviceAddresses.Output, Mode=OneWay}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button MinWidth="155" MinHeight="38" Content="In FEE erzeugen" Command="{Binding CreateSpecialDevicesCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" />
                        <Button MinWidth="135" MinHeight="38" Margin="7,0,0,0" Content="Auswahl entfernen" Command="{Binding DeleteSelectedDevicesCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" />
                        <Button MinWidth="115" MinHeight="38" Margin="7,0,0,0" Content="Alle entfernen" Command="{Binding DeleteAllDevicesCommand}" IsEnabled="{Binding CanModifyDeviceQueue}" />
                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SpecialDevices.Count, StringFormat={}Anzahl: {0}}" />
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3" Header="Hardware aus geöffnetem TIA-Projekt lesen" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="TIA-Version:" />
                    <ComboBox Width="115" MinHeight="34" ItemsSource="{Binding InstalledTiaVersions}" SelectedItem="{Binding SelectedTiaVersion}" />
                    <Button MinWidth="145" MinHeight="34" Margin="7,0,0,0" Content="Mit TIA verbinden" Command="{Binding ConnectTiaCommand}" />
                    <TextBlock Margin="22,0,7,0" VerticalAlignment="Center" Text="PLC:" />
                    <ComboBox Width="260" MinHeight="34" ItemsSource="{Binding TiaPlcs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTiaPlc}" />
                    <Button MinWidth="105" MinHeight="34" Margin="7,0,0,0" Content="Auswählen" Command="{Binding SelectTiaPlcCommand}" />
                    <Button MinWidth="155" MinHeight="34" Margin="7,0,0,0" Content="Hardware auslesen" Command="{Binding ReadTiaHardwareCommand}" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Margin="0,8" Foreground="#FF666666" Text="TIA-Modulstruktur und E-/A-Byteadressen werden gelesen. Logik, Präfix und Adressen vor der Übernahme prüfen." TextWrapping="Wrap" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding TiaHardwareRows}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="32" ColumnHeaderHeight="36" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Übernehmen" Binding="{Binding Include}" Width="86" />
                        <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceName, Mode=OneWay}" IsReadOnly="True" Width="240" />
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot, Mode=OneWay}" IsReadOnly="True" Width="60" />
                        <DataGridTextColumn Header="Modul" Binding="{Binding ModuleName, Mode=OneWay}" IsReadOnly="True" Width="160" />
                        <DataGridTextColumn Header="Modultyp" Binding="{Binding ModuleType, Mode=OneWay}" IsReadOnly="True" Width="150" />
                        <DataGridTextColumn Header="TIA-Typkennung" Binding="{Binding TypeIdentifier, Mode=OneWay}" IsReadOnly="True" Width="220" />
                        <DataGridTextColumn Header="Firmware" Binding="{Binding FirmwareVersion, Mode=OneWay}" IsReadOnly="True" Width="85" />
                        <DataGridTextColumn Header="E-Start" Binding="{Binding InputByte, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridTextColumn Header="E-Bereich" Binding="{Binding InputAddressRange, Mode=OneWay}" IsReadOnly="True" Width="92" />
                        <DataGridTextColumn Header="A-Start" Binding="{Binding OutputByte, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridTextColumn Header="A-Bereich" Binding="{Binding OutputAddressRange, Mode=OneWay}" IsReadOnly="True" Width="92" />
                        <DataGridTextColumn Header="E-Länge (Byte)" Binding="{Binding InputLength, Mode=OneWay}" IsReadOnly="True" Width="105" />
                        <DataGridTextColumn Header="A-Länge (Byte)" Binding="{Binding OutputLength, Mode=OneWay}" IsReadOnly="True" Width="105" />
                        <DataGridTextColumn Header="Präfix" Binding="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="135" />
                        <DataGridTemplateColumn Header="Logik" Width="235">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox MinHeight="27" ItemsSource="{Binding DataContext.HardwareLogicOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLogic}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding State, Mode=OneWay}" IsReadOnly="True" Width="105" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="3" Margin="0,9,0,0">
                    <Button DockPanel.Dock="Right" MinWidth="285" MinHeight="36" Content="Ausgewählte Geräte in Warteschlange übernehmen" Command="{Binding AddSelectedHardwareDevicesCommand}" />
                    <ProgressBar DockPanel.Dock="Right" Width="125" Height="7" Margin="0,0,14,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusyTia, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </DockPanel>
            </Grid>
        </GroupBox>
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10,7" Background="#FFF3F5F7" CornerRadius="3"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /></Border>
    </Grid>
</UserControl>
