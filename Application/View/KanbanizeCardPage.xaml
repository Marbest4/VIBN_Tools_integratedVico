<UserControl x:Class="VIBN_Tools.Application.View.KanbanizeCardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Kanbanize Karten" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF666666"
                           Text="Neue Karte direkt in einem zugänglichen Board anlegen – ohne Lizenz- oder Anfragenworkflow."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="170"
                    MinHeight="38"
                    VerticalAlignment="Center"
                    Content="Boards aktualisieren"
                    Command="{Binding ReloadBoardsCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.35*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Zielposition">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Board:" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              MinHeight="34"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding Boards}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedBoard}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Lane:" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              MinHeight="34"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding Lanes}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedLane}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Spalte:" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              MinHeight="34"
                              ItemsSource="{Binding Columns}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedColumn}" />

                    <Border Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,18,0,0"
                            Padding="12"
                            Background="#FFF3F5F7"
                            CornerRadius="4">
                        <TextBlock Foreground="#FF555555"
                                   Text="Nach der Lane-Auswahl zeigt die Spaltenliste nur Positionen desselben Workflows. Die Berechtigung zum Erstellen prüft Kanbanize mit dem hinterlegten API-Schlüssel."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Neue Karte">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Titel:*" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             MinHeight="34"
                             Margin="0,0,0,12"
                             MaxLength="255"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,12" VerticalAlignment="Center" Text="Externe ID:" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             MinHeight="34"
                             Margin="0,0,0,12"
                             Text="{Binding CustomId, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Priorität:" />
                        <ComboBox Grid.Column="1"
                                  MinHeight="34"
                                  ItemsSource="{Binding Priorities}"
                                  SelectedItem="{Binding SelectedPriority}" />
                        <CheckBox Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Content="Deadline"
                                  IsChecked="{Binding HasDeadline}" />
                        <DatePicker Grid.Column="4"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding HasDeadline}"
                                    SelectedDate="{Binding Deadline}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Details:" />

                    <TextBox Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             MinHeight="180"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal">
                        <Button MinWidth="160"
                                MinHeight="38"
                                Content="Karte erstellen"
                                Command="{Binding CreateCardCommand}"
                                IsEnabled="{Binding CanCreate}" />
                        <TextBlock Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF666666"
                                   Text="Priorität 1 = hoch, 4 = niedrig" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="10,7" Background="#FFF3F5F7" CornerRadius="3">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
