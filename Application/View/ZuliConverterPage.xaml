<UserControl x:Class="VIBN_Tools.Application.View.ZuliConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ux="http://Grob.com/wpf.ux"
             xmlns:uxb="http://Grob.com/wpf.ux.behaviors"
             xmlns:local="clr-namespace:VIBN_Tools.Application.View"
             xmlns:g="clr-namespace:VIBN_Tools.GlobalClasses"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">


    <UserControl.DataContext>
        <vm:ZuliConverterPageVM/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary  Source="pack://application:,,,/Grob.UX;component/Styles/ScrollBarStyles.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            
            <!--Datatemplates for different option styles-->
            <DataTemplate x:Key="TextBlockContentTemplate">
                <TextBlock Text="{Binding ValueObject}" Style="{StaticResource TextRobotoRegularStyle}"/>
            </DataTemplate>
            
            <DataTemplate x:Key="TextBoxContentTemplate">
                <ux:TextBox Text="{Binding ValueObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <DataTemplate x:Key="ComboBoxContentTemplate">
                <ux:ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding ValueObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Select Item" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <DataTemplate x:Key="CheckBoxContentTemplate">
                <ux:CheckBox IsChecked="{Binding ValueObject, Mode=TwoWay}" Style="{StaticResource CheckBoxSmallStyle}" IsEnabled="{Binding ViewElementEnabled}"/>
            </DataTemplate>

            <g:ViewElementTemplateSelector x:Key="TemplateSelectorViewElement" 
                                           TextBlockTemplate="{StaticResource TextBlockContentTemplate}"
                                           TextBoxTemplate="{StaticResource TextBoxContentTemplate}"
                                           ComboBoxTemplate="{StaticResource ComboBoxContentTemplate}"
                                           CheckBoxTemplate="{StaticResource CheckBoxContentTemplate}"/>
            <!--TextBlockTemplate="{StaticResource TextBlockContentTemplate}"
                                           TextBoxTemplate="{StaticResource TextBoxContentTemplate}"
                                           ComboBoxTemplate="{StaticResource ComboBoxContentTemplate}"
                                           CheckBoxTemplate="{StaticResource CheckBoxContentTemplate}" />-->



        </ResourceDictionary>      
    </UserControl.Resources>
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="File-Import"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ux:TextBox Grid.Row="0" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Watermark="Path to Zuli-File" Text="{Binding FileNameZuli}" IsReadOnly="True"/>
                <ux:Button Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="200" Content="Open Zuli FIle" Command="{Binding OpenZuliFile}" DebounceInterval="150"/>
            </Grid>
        </GroupBox>


        <GroupBox Grid.Row="1" Grid.Column="0" Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="Options"/>
            </GroupBox.Header>

            <ItemsControl ItemsSource="{Binding OptionFields}" Grid.IsSharedSizeScope="True" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="10,10,50,10" Text="{Binding Label}" Style="{StaticResource TextRobotoLightStyle}" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource  TemplateSelectorViewElement}"/>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            
        </GroupBox>


        <GroupBox Grid.Row="1" Grid.Column="1" Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource H3Style}" Text="Status Information"/>
            </GroupBox.Header>

            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl x:Name="StatusFieldsControl" Grid.Row="0" ItemsSource="{Binding StatusFields}" Grid.IsSharedSizeScope="True" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="10,10,50,10" Text="{Binding Label}" Style="{StaticResource TextRobotoLightStyle}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource TemplateSelectorViewElement}"/>
                                
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ux:Button Grid.Row="2" Margin="10" Content="Create Interface File" Command="{Binding CreateImportFile}" IsBusy="{Binding IsBusyCreateImportFile}"/>
                </Grid>
        </GroupBox>

        


    </Grid>
</UserControl>
