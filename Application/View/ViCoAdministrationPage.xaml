<UserControl x:Class="VIBN_Tools.Application.View.ViCoAdministrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button MinWidth="120" Content="Aktualisieren" Command="{Binding RefreshCommand}" />
                <Button MinWidth="150" Margin="8,0,0,0" Content="Lizenz anfragen" Command="{Binding RequestLicenseCommand}" IsEnabled="{Binding IsLicenseConfigured}" />
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Text="Angemeldet als:" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CurrentUser}" />
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Text="Berechtigung:" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CurrentLevel}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Text="{Binding LicenseStatus}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Heutige Outlook-Termine">
                <ListBox ItemsSource="{Binding Meetings}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" />
                                <TextBlock>
                                    <Run Text="{Binding Start, StringFormat={}{0:HH:mm}}" />
                                    <Run Text=" – " />
                                    <Run Text="{Binding End, StringFormat={}{0:HH:mm}}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Lizenzverwaltung">
                    <DataGrid ItemsSource="{Binding LicenseEntries}"
                              SelectedItem="{Binding SelectedLicense}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Neues Level:" />
                        <ComboBox Width="150" ItemsSource="{Binding LicenseLevels}" SelectedItem="{Binding SelectedLevel}" />
                        <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="Zusätzlicher Level9-Benutzer:" />
                        <ComboBox Width="190"
                                  ItemsSource="{Binding LicenseEntries}"
                                  SelectedItem="{Binding AdditionalLevel9License}"
                                  DisplayMemberPath="UserName"
                                  ToolTip="Optional: Wird benötigt, wenn die Änderung sonst weniger als zwei Level9-Benutzer hinterlassen würde." />
                        <Button MinWidth="120" Margin="8,0,0,0" Content="Level speichern" Command="{Binding SaveLicenseCommand}" IsEnabled="{Binding CanManageLicenses}" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Level9CoverageText}" />
                        <Button MinWidth="170" Margin="24,0,0,0" Content="Versionsordner öffnen" Command="{Binding OpenUpdateCommand}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding LatestUpdate.Version}" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
