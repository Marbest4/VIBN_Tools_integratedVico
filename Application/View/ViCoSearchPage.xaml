<UserControl x:Class="VIBN_Tools.Application.View.ViCoSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     MinHeight="36"
                     Padding="8,5"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="PC, Kanbanize-Benutzer, Projekt-, GM- oder GU-Nummer eingeben"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    MinWidth="190"
                    MinHeight="36"
                    Margin="8,0,0,0"
                    FontSize="14"
                    Content="Daten aktualisieren"
                    ToolTip="Aktualisiert Kanbanize-Daten und lädt anschließend den lokalen Cache; ohne API-Zugriff wird nur der Cache geladen."
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.45*" MinWidth="720" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="390" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedWorkstation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      FontSize="13.5"
                      RowHeight="34"
                      ColumnHeaderHeight="38"
                      HorizontalScrollBarVisibility="Auto"
                      FrozenColumnCount="2">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Belegung" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="5,3" Background="{Binding StatusBackground, Mode=OneWay}" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Status, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PC" Binding="{Binding PcName, Mode=OneWay}" Width="94" />
                    <DataGridTextColumn Header="Projekt(e)" Binding="{Binding ProjectSummary, Mode=OneWay}" Width="205" />
                    <DataGridTemplateColumn Header="Software" Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ConfigurationSoftware, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationSoftware, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Standort" Binding="{Binding ConfigurationLocation, Mode=OneWay}" Width="135" />
                    <DataGridTextColumn Header="Projekt-IP" Binding="{Binding ConfigurationProjectIp, Mode=OneWay}" Width="130" />
                    <DataGridTemplateColumn Header="Sonstiges" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ConfigurationOther, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationOther, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="RDP-Sitzung" Width="175">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RemoteSessionStatus, Mode=OneWay}" ToolTip="{Binding RemoteSessionDiagnostic, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Letzte Anmeldung" Width="195">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastRemoteLogon, Mode=OneWay}" ToolTip="{Binding RemoteSessionDiagnostic, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName, Mode=OneWay}" Width="150" />
                    <DataGridTemplateColumn Header="Online" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="5,3" Background="{Binding OnlineStatusBackground, Mode=OneWay}" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding OnlineStatus, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Konfiguration" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="5,3" Background="{Binding ConfigurationStatusBackground, Mode=OneWay}" CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding ConfigurationStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#FFD0D5DC" ShowsPreview="True" />

            <ScrollViewer Grid.Column="2" Padding="12,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextBlock.FontSize="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedWorkstation.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />

                    <Border Margin="0,8,0,0" Padding="7,4" Background="{Binding SelectedWorkstation.StatusBackground, Mode=OneWay}" CornerRadius="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedWorkstation.Status, Mode=OneWay}" />
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="Remote-Benutzer:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRemoteUser, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,0" FontWeight="SemiBold" Text="RDP-Sitzung:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Text="{Binding SelectedWorkstation.RemoteSessionStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,0" FontWeight="SemiBold" Text="Letzte Anmeldung:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Text="{Binding SelectedWorkstation.LastRemoteLogon, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="8" Background="#FFF3F5F7" CornerRadius="3">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Arbeitsplatz-Konfiguration" />
                                <Button DockPanel.Dock="Right"
                                        MinWidth="105"
                                        Content="Speichern"
                                        Command="{Binding SaveConfigurationCommand}"
                                        IsEnabled="{Binding CanEditConfiguration}"
                                        Visibility="{Binding HasSelectedConfigurationCard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button DockPanel.Dock="Right"
                                        Margin="0,0,6,0"
                                        MinWidth="150"
                                        Content="Standardkarte anlegen"
                                        Command="{Binding CreateConfigurationCommand}"
                                        IsEnabled="{Binding CanCreateConfiguration}"
                                        Visibility="{Binding IsSelectedConfigurationMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,7" FontSize="12.5" Foreground="#FF666666" Text="USER, STANDORT, SW, PROJEKT-IP und SONSTIGES werden als standardisierte Unteraufgaben gespeichert. Fehlende Unteraufgaben werden beim Speichern ergänzt." TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding ConfigurationFields}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="True"
                                      HeadersVisibility="Column"
                                      MinHeight="155"
                                      MaxHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Feld" Binding="{Binding Key, Mode=OneWay}" IsReadOnly="True" Width="115" />
                                    <DataGridTemplateColumn Header="Wert" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="28">
                                                </TextBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Alle Karten dieser Arbeitsplatz-Lane" />
                    <ComboBox MinHeight="36" Padding="7,4" FontSize="14" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />

                    <TextBlock Margin="0,12,0,0" FontFamily="Consolas" FontSize="12.5" Text="{Binding PathInformation, Mode=OneWay}" TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding CanUseSelectedWorkstationActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Monitore" />
                        <WrapPanel>
                            <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
                            <CheckBox Margin="12,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" />
                            <CheckBox Margin="12,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" />
                            <CheckBox Margin="12,0,0,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" />
                        </WrapPanel>

                        <UniformGrid Margin="0,10,0,0" Columns="2">
                            <Button MinHeight="36" Margin="0,3,3,3" Content="Remote Desktop" ToolTip="Startet die hinterlegte automatische Anmeldung." Command="{Binding ConnectRemoteCommand}" />
                            <Button MinHeight="36" Margin="3" Content="RDP mit Anmeldedaten" ToolTip="Öffnet Remote Desktop mit Windows-Anmeldedialog ohne automatische Anmeldung." Command="{Binding ConnectRemoteWithPromptCommand}" />
                            <Button MinHeight="36" Margin="0,3,3,3" Content="PC-Projektordner" Command="{Binding OpenPcProjectsCommand}" />
                            <Button MinHeight="36" Margin="3" Content="Simulation" Command="{Binding OpenSimulationCommand}" />
                            <Button MinHeight="36" Margin="0,3,3,3" Content="PLC-Projekt" Command="{Binding OpenCommissioningCommand}" />
                            <Button MinHeight="36" Margin="3" Content="Planung" Command="{Binding OpenPlanningCommand}" />
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#FF8A3B3B"
                               Visibility="{Binding IsSelectedWorkstationOffline, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="Der PC ist offline; Remote- und Pfadaktionen stehen deshalb nicht zur Verfügung." />

                    <Expander Margin="0,14,0,0" Header="Alle Kanbanize-Informationen (inkl. Backlog / Abschluss)">
                        <ItemsControl ItemsSource="{Binding SelectedWorkstation.Details, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Kartenstatus:" />
            <Border Margin="8,0,0,0" Padding="7,3" Background="#FFE3E7ED" CornerRadius="3"><TextBlock Text="[B] Backlog" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFFF2CC" CornerRadius="3"><TextBlock Text="[P] Planung" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFDDEBF7" CornerRadius="3"><TextBlock Text="[W] In Arbeit" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="[D] Erledigt" /></Border>
            <Border Margin="16,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="Frei: nur Backlog/Erledigt" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFCE4D6" CornerRadius="3"><TextBlock Text="Belegt: Planung/In Arbeit" /></Border>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" Text="Online = grün, Offline = rot. RDP-Informationen sind bei fehlender Berechtigung als „Nicht abrufbar“ gekennzeichnet." />
        </WrapPanel>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="13.5" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
