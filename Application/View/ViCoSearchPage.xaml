<UserControl x:Class="VIBN_Tools.Application.View.ViCoSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" VerticalAlignment="Center" Content="Projekt" IsChecked="{Binding IsProjectMode}" />
            <RadioButton Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center" Content="PC" IsChecked="{Binding IsWorkstationMode}" />
            <TextBox Grid.Column="2" ToolTip="Projekt-, GM-/GU-Nummer oder PC eingeben" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" MinWidth="120" Margin="8,0,0,0" Content="Neu laden" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="4" MinWidth="150" Margin="8,0,0,0" Content="Kanbanize abrufen" Command="{Binding RefreshOnlineCommand}" IsEnabled="{Binding CanRefreshOnline}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedWorkstation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      FrozenColumnCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="PC" Binding="{Binding PcName, Mode=OneWay}" Width="105" />
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName, Mode=OneWay}" Width="165" />
                    <DataGridTextColumn Header="Projekt(e)" Binding="{Binding ProjectSummary, Mode=OneWay}" Width="240" />
                    <DataGridTemplateColumn Header="Software" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SoftwareInformation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SoftwareInformation}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="FEE" Binding="{Binding FeeInformation, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Hardware / LAN" Binding="{Binding HardwareInformation, Mode=OneWay}" Width="150" />
                    <DataGridTemplateColumn Header="Roboter (Kanbanize)" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RobotCount}" TextAlignment="Center" ToolTip="{Binding RobotSummary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Online" Binding="{Binding OnlineStatus, Mode=OneWay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedWorkstation.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="Remote-Benutzer:" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRemoteUser, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Software (laut Kanbanize)" />
                    <ItemsControl ItemsSource="{Binding SelectedWorkstation.SoftwareDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding DisplayName}" />
                                    <Run Text=" – " />
                                    <Run Text="{Binding EvidenceLabel}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Roboter (Kanbanize)" />
                    <TextBlock Text="{Binding SelectedWorkstation.RobotSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkstation.FeeInformation, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkstation.HardwareInformation, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedWorkstation.OnlineStatus, Mode=OneWay}" />

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Aktives Projekt" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />

                    <TextBlock Margin="0,12,0,0" FontFamily="Consolas" FontSize="11" Text="{Binding PathInformation, Mode=OneWay}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Monitore" />
                    <WrapPanel>
                        <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
                        <CheckBox Margin="12,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" />
                        <CheckBox Margin="12,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" />
                        <CheckBox Margin="12,0,0,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" />
                    </WrapPanel>

                    <UniformGrid Margin="0,10,0,0" Columns="2">
                        <Button Margin="0,3,3,3" Content="Remote Desktop" Command="{Binding ConnectRemoteCommand}" />
                        <Button Margin="3" Content="TeamViewer" Command="{Binding OpenTeamViewerCommand}" />
                        <Button Margin="0,3,3,3" Content="PC-Projektordner" Command="{Binding OpenPcProjectsCommand}" />
                        <Button Margin="3" Content="Simulation" Command="{Binding OpenSimulationCommand}" />
                        <Button Margin="0,3,3,3" Content="PLC-Projekt" Command="{Binding OpenCommissioningCommand}" />
                        <Button Margin="3" Content="Planung" Command="{Binding OpenPlanningCommand}" />
                    </UniformGrid>

                    <Expander Margin="0,14,0,0" Header="Alle Kanbanize-Informationen">
                        <ItemsControl ItemsSource="{Binding SelectedWorkstation.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Status:" />
            <Border Margin="8,0,0,0" Padding="7,3" Background="#FFE3E7ED" CornerRadius="3"><TextBlock Text="[B] Backlog" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFFF2CC" CornerRadius="3"><TextBlock Text="[P] Planung" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFDDEBF7" CornerRadius="3"><TextBlock Text="[W] In Arbeit" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="[D] Erledigt" /></Border>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" Text="Software und Roboter werden aus Kanbanize-Karten ermittelt." />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
