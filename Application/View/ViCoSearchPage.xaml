<UserControl x:Class="VIBN_Tools.Application.View.ViCoSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" MinHeight="36" Padding="8,5" FontSize="14" VerticalContentAlignment="Center" ToolTip="PC, Kanbanize-Benutzer, Projekt-, GM- oder GU-Nummer eingeben" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" MinWidth="190" MinHeight="36" Margin="8,0,0,0" FontSize="14" Content="Daten aktualisieren" ToolTip="Aktualisiert Kanbanize-Daten und lädt anschließend den lokalen Cache; ohne API-Zugriff wird nur der Cache geladen." Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="620" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedWorkstation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      FontSize="13.5"
                      RowHeight="34"
                      ColumnHeaderHeight="38"
                      HorizontalScrollBarVisibility="Auto"
                      FrozenColumnCount="2">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Belegung" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="5,3"
                                        Background="{Binding StatusBackground, Mode=OneWay}"
                                        CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Status, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PC" Binding="{Binding PcName, Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName, Mode=OneWay}" Width="135" />
                    <DataGridTextColumn Header="Projekt(e)" Binding="{Binding ProjectSummary, Mode=OneWay}" Width="190" />
                    <DataGridTemplateColumn Header="Software" Width="165">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SoftwareInformation, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SoftwareInformation, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="FEE" Binding="{Binding FeeInformation, Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Hardware / LAN" Binding="{Binding HardwareInformation, Mode=OneWay}" Width="120" />
                    <DataGridTemplateColumn Header="Roboter" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RobotCount, Mode=OneWay}" TextAlignment="Center" ToolTip="{Binding RobotSummary, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Online" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="5,3"
                                        Background="{Binding OnlineStatusBackground, Mode=OneWay}"
                                        CornerRadius="3">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding OnlineStatus, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#FFD0D5DC" ShowsPreview="True" />

            <ScrollViewer Grid.Column="2" Padding="12,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextBlock.FontSize="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedWorkstation.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />

                    <Border Margin="0,8,0,0"
                            Padding="7,4"
                            Background="{Binding SelectedWorkstation.StatusBackground, Mode=OneWay}"
                            CornerRadius="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedWorkstation.Status, Mode=OneWay}" />
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="Remote-Benutzer:" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRemoteUser, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Software (laut Kanbanize)" />
                    <ItemsControl ItemsSource="{Binding SelectedWorkstation.SoftwareDetails, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                    <Run Text=" – " />
                                    <Run Text="{Binding EvidenceLabel, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Roboter (Kanbanize)" />
                    <TextBlock Text="{Binding SelectedWorkstation.RobotSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkstation.FeeInformation, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkstation.HardwareInformation, Mode=OneWay}" TextWrapping="Wrap" />
                    <Border Margin="0,4,0,0"
                            Padding="7,4"
                            Background="{Binding SelectedWorkstation.OnlineStatusBackground, Mode=OneWay}"
                            CornerRadius="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedWorkstation.OnlineStatus, Mode=OneWay}" />
                    </Border>

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Aktives Projekt" />
                    <ComboBox MinHeight="36" Padding="7,4" FontSize="14" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />

                    <TextBlock Margin="0,12,0,0" FontFamily="Consolas" FontSize="12.5" Text="{Binding PathInformation, Mode=OneWay}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Monitore" />
                    <WrapPanel>
                        <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
                        <CheckBox Margin="12,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" />
                        <CheckBox Margin="12,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" />
                        <CheckBox Margin="12,0,0,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" />
                    </WrapPanel>

                    <UniformGrid Margin="0,10,0,0" Columns="2">
                        <Button MinHeight="36" Margin="0,3,3,3" Content="Remote Desktop" Command="{Binding ConnectRemoteCommand}" />
                        <Button MinHeight="36" Margin="3" Content="TeamViewer" Command="{Binding OpenTeamViewerCommand}" />
                        <Button MinHeight="36" Margin="0,3,3,3" Content="PC-Projektordner" Command="{Binding OpenPcProjectsCommand}" />
                        <Button MinHeight="36" Margin="3" Content="Simulation" Command="{Binding OpenSimulationCommand}" />
                        <Button MinHeight="36" Margin="0,3,3,3" Content="PLC-Projekt" Command="{Binding OpenCommissioningCommand}" />
                        <Button MinHeight="36" Margin="3" Content="Planung" Command="{Binding OpenPlanningCommand}" />
                    </UniformGrid>

                    <Expander Margin="0,14,0,0" Header="Alle Kanbanize-Informationen">
                        <ItemsControl ItemsSource="{Binding SelectedWorkstation.Details, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Kartenstatus:" />
            <Border Margin="8,0,0,0" Padding="7,3" Background="#FFE3E7ED" CornerRadius="3"><TextBlock Text="[B] Backlog" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFFF2CC" CornerRadius="3"><TextBlock Text="[P] Planung" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFDDEBF7" CornerRadius="3"><TextBlock Text="[W] In Arbeit" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="[D] Erledigt" /></Border>
            <Border Margin="16,0,0,0" Padding="7,3" Background="#FFE2F0D9" CornerRadius="3"><TextBlock Text="Frei: nur Backlog/Erledigt" /></Border>
            <Border Margin="6,0,0,0" Padding="7,3" Background="#FFFCE4D6" CornerRadius="3"><TextBlock Text="Belegt: Planung/In Arbeit" /></Border>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF666666" Text="Software und Roboter werden aus Kanbanize-Karten ermittelt." />
        </WrapPanel>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="13.5" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
