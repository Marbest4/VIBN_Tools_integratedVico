<UserControl x:Class="VIBN_Tools.Application.View.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="Diagnoseprotokoll" IsExpanded="False" MaxHeight="260">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button MinWidth="90" Content="Kopieren" Command="{Binding CopyCommand}" />
                <Button MinWidth="110" Margin="6,0,0,0" Content="Logordner" Command="{Binding OpenLogFolderCommand}" />
                <Button MinWidth="80" Margin="6,0,0,0" Content="Leeren" Command="{Binding ClearCommand}" />
            </StackPanel>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      EnableRowVirtualization="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                    <DataGridTextColumn Header="Stufe" Binding="{Binding Level}" Width="90" />
                    <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="130" />
                    <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="2*" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Expander>
</UserControl>
