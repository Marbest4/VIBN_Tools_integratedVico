<UserControl x:Class="VIBN_Tools.Application.View.ViCoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ViCo"
                   Style="{StaticResource H1Style}" />

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     MinHeight="36"
                     Margin="0,0,12,0"
                     Padding="8,5"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="GM- oder Projektnummer eingeben"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    MinWidth="150"
                    MinHeight="36"
                    FontSize="14"
                    Content="Index aktualisieren"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Projekte">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              FontSize="13.5"
                              RowHeight="36"
                              ColumnHeaderHeight="38"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Projekt" Binding="{Binding DisplayName, Mode=OneWay}" Width="240" />
                            <DataGridTextColumn Header="Pfad" Binding="{Binding FullPath, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="110"
                                Content="Öffnen"
                                Command="{Binding OpenProjectCommand}" />
                        <Button MinWidth="150"
                                Margin="8,0,0,0"
                                Content="Als Favorit speichern"
                                Command="{Binding AddFavoriteCommand}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#FFD0D5DC" ShowsPreview="True" />

            <GroupBox Grid.Column="2" Header="Favoriten">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Favorites}"
                             SelectedItem="{Binding SelectedFavorite}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Opacity="0.7" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="100"
                                Content="Öffnen"
                                Command="{Binding OpenFavoriteCommand}" />
                        <Button MinWidth="100"
                                Margin="8,0,0,0"
                                Content="Entfernen"
                                Command="{Binding RemoveFavoriteCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0"
                                 Margin="0,0,0,6"
                                 ToolTip="Anzeigename"
                                 Text="{Binding FavoriteName}" />
                        <TextBox Grid.Row="1"
                                 Margin="0,0,0,6"
                                 ToolTip="Datei- oder Ordnerpfad"
                                 Text="{Binding FavoritePath}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button MinWidth="80" Content="Ordner …" Command="{Binding BrowseFavoriteFolderCommand}" />
                            <Button MinWidth="80" Margin="6,0,0,0" Content="Datei …" Command="{Binding BrowseFavoriteFilesCommand}" />
                            <Button MinWidth="90" Margin="6,0,0,0" Content="Speichern" Command="{Binding SaveFavoriteCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="160"
                         Height="6"
                         Margin="12,0,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
