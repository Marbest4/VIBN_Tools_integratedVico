<UserControl x:Class="VIBN_Tools.Application.View.MiniToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ux="http://Grob.com/wpf.ux"
             xmlns:uxb="http://Grob.com/wpf.ux.behaviors"
             xmlns:local="clr-namespace:VIBN_Tools.Application.View"
             xmlns:g="clr-namespace:VIBN_Tools.GlobalClasses"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <d:UserControl.DataContext>
        <d:DesignInstance Type="vm:MiniToolsPageVM" IsDesignTimeCreatable="True"/>
    </d:UserControl.DataContext>
    

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary  Source="pack://application:,,,/Grob.UX;component/Styles/ScrollBarStyles.xaml"/>-->
                <ResourceDictionary Source="pack://application:,,,/Grob.UX;component/Styles/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Margin="10">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource CheckBoxStyle}" Text="MiniTools"/>
            </GroupBox.Header>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Margin="5,20,5,10" Text="{Binding ProjectSettings.SelectedTemplate, StringFormat={}PLC-Type: {0}}" Style="{StaticResource H3Style}"/>
                <ux:Button Margin="5" Content="Deactivate Forcing Mode" Style="{StaticResource PrimaryButton}" Command="{Binding DeactivateForcing}" IsBusy="{Binding IsBusyDeactivateForcing}" DebounceInterval="150"/>
                <ux:Button Margin="5" Content="Hide unneccesary objecst" Style="{StaticResource PrimaryButton}" Command="{Binding HideObjects}" IsBusy="{Binding IsBusyHideObjects}" DebounceInterval="150"/>
                <ux:Button Margin="5" Content="Show/Hide all Inserter/Remover" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleInserter}" IsBusy="{Binding IsBusyToggleInserter}" DebounceInterval="150"/>
                <ux:Button Margin="5" Content="Create standard Surface" Style="{StaticResource PrimaryButton}" Command="{Binding CreateSurface}" IsBusy="{Binding IsBusyCreateSurface}" DebounceInterval="150"/>
                <ux:Button Margin="5" Content="Baseline-Editor öffnen" Style="{StaticResource PrimaryButton}" Command="{Binding OpenEditorButton}" IsBusy="{Binding IsBusyBlEditor}" DebounceInterval="150"/>
                <ux:Button Margin="5" Content="Baseline prüfen" Style="{StaticResource PrimaryButton}" Command="{Binding BtnBaselineEditor}" IsBusy="{Binding IsBusyBlCheck}" DebounceInterval="150"/>

            </StackPanel>
        </GroupBox>

    </Grid>
</UserControl>
