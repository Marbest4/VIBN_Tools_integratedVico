<LogicDefinition V="001" xsi:type="CSharpLogicDefinition" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Guid="ea437633-9435-411e-bc1c-77b73c3f5ace" LogicName="DMC_WT-Helper" LogicProvider="fe4a121e-169b-4fb0-8004-e2e53c268b26">
	<ScriptText>#load "reference"
#load "reference"

//////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                          //
//    Logik:           DMC_WT-Helper                                                                        //
//                                                                                                          //
//////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
//    Datum            Version        Autor            Beschreibung
//
//    06.06.2025       1.11.0         Greif            Header integriert
//
//============================================================================================================
//
//    SW-Standard      Geprüft        Prüfer           Allgemeine Informationen
//                     
//    FEE                                              WT-Nummer generieren (Aufsteigend +1)
/*
//============================================================================================================
//
//    Beschreibung:
//
//    Die Logik generiert eine Palettennummer zwischen ihren Grenzwerten, welche mit einem Prefix oder Sufix
//    angepasst werden kann. Es wird eine WT-Nummer (SIM_WritingUnit_DMC_WT) generiert, diese wird innerhalb
//    der Grenzwerte (PAR_NumberMin und PAR_NumberMax) immer um 1 erhöht. Die Nummer kann mit vorangestellten
//    (PAR_Prefix) oder nachgestellten (PAR_Suffix), Zeichen oder Zahlen angepasst werden.
//    Wenn die WT-Nummer  zurückgesetzt (PAR_CounterReset=1) wird, startet die neue Nummer wieder beim 
//    minimalen Grenzwert.
//
//============================================================================================================
//
//    Input Slot Values
//    SIM_ReadingUnit_IsDetecting   =   Bool, Leseeinheit erkennt Daten
//    SIM_ReadingUnit_DMC_WT        =   String, Leseeinheit WT Daten
//    SIM_WritingUnit_IsDetecting   =   Bool, Schreibeinheit erkennt Daten
//    SIM_WritingUnit_WriteOk       =   Bool, Schreibeinheit schreiben Ok
//    PAR_Init_Value                =   String, Initialisierungs-Wert
//    PAR_NumberMin                 =   String, unterer Grenzwert
//    PAR_NumberMax                 =   String, oberer Grenzwert
//    PAR_Prefix                    =   String, Prefix (vorangestellt)
//    PAR_Suffix                    =   String, Suffix (nachgestellt)
//    PAR_ActivateSuffix            =   Bool, aktiviere Suffix
//    PAR_CounterReset              =   Bool, Zurücksetzen des Zählers
//
//    Output Slot Values
//    SIM_ReadingUnit_DoRead        =   Bool, Lesen aktivieren
//    SIM_WritingUnit_DoWrite       =   Bool, Schreiben aktivieren
//    SIM_WritingUnit_DMC_WT        =   String, WT Daten 
//    SIM_WritingUnit_WriteDone     =   Bool, Daten wurden geschrieben
//
//============================================================================================================
*/
//////////////////////////////////////////////////////////////////////////////////////////////////////////////

#region Abbruchbedingungen prüfen
//============================================================================================================
// A B B R U C H B E D I N G U N G E N   P R U E F E N
//============================================================================================================

// Lesen wenn Tag erkannt
SIM_ReadingUnit_DoRead = SIM_ReadingUnit_IsDetecting;

if(String.IsNullOrEmpty(SIM_ReadingUnit_DMC_WT) || (String.IsNullOrEmpty(PAR_Init_Value)) )
{
    return;
}

if(String.IsNullOrEmpty(PAR_Prefix))
{
    return;
}

#endregion

// kontrollieren ob Suffix beschrieben wurde
noSuffix = String.IsNullOrEmpty(PAR_Suffix);

#region Zähler setzen
//============================================================================================================
// Z Ä H L E R    S E T Z E N
//============================================================================================================

//Zur Kontrolle NumberMax ausgeben
numberMaxOut = PAR_NumberMax;

// Zähler zurücksetzen
if (iNumber &gt; PAR_NumberMax || iNumber &lt; PAR_NumberMin || PAR_CounterReset)
{
    iNumber = Convert.ToInt32(PAR_NumberMin - 1);
    
}

#endregion

#region Trigger setzen
//============================================================================================================
// T R I G G E R    S E T Z E N
//============================================================================================================

trigger = SIM_WritingUnit_IsDetecting &amp;&amp; SIM_ReadingUnit_DMC_WT == PAR_Init_Value;   

// Trigger hochzählen
if (trigger &amp;&amp; !trigger_Helper)
{
    // Gesamtzähler hochzählen
    iNumber++;
    // ungerade Zahl hochzählen
    if (iNumber % 2 == 1) { iNumberWithOffset++; }
    // gerade Zahl hochzählen
    if (iNumber % 2 == 0) { iNumberNoOffset++; }
}

// Trigger Flanke aktualisieren
trigger_Helper = trigger;

#endregion

#region Ausgänge setzen
//============================================================================================================
// A U S G Ä N G E    S E T Z E N
//============================================================================================================

// Anhand der Länge werden die 0-Stellen ermittelt und entsprechend ausgegeben
char pad = '0';
int NumberLength = Convert.ToInt32(Convert.ToString(PAR_NumberMax).Length);
iNumberTemp = iNumber;
string Pad0 = Convert.ToString(iNumberTemp);

Pad0 = Pad0.PadLeft(NumberLength, pad);

output = PAR_Prefix + Pad0 ;

//// Ausgabe Einerstellen 00x
//if (_iNumberTemp &lt; 10)
//{
//    _Output = PARA_Prefix + 0 + 0 + (_iNumberTemp);
//}
//// Ausgabe Zehnerstellen 0xx
//else if (_iNumberTemp &gt;= 10 &amp;&amp; _iNumberTemp &lt; 100)
//{
//    _Output = PARA_Prefix + 0 + (_iNumberTemp);
//}
//// Ausgabe Hunderterstellen xxx
//else if (_iNumberTemp &gt;= 100)
//{
//    _Output = PARA_Prefix + (_iNumberTemp);
//}

//Schreiben nur wenn Tag noch nicht bereits beschrieben
if (SIM_WritingUnit_IsDetecting &amp;&amp; SIM_ReadingUnit_DMC_WT == PAR_Init_Value)
{

    if (!noSuffix &amp;&amp; PAR_ActivateSuffix)
    {
        SIM_WritingUnit_DMC_WT = output + PAR_Suffix;
    }
    else 
    {
        SIM_WritingUnit_DMC_WT = output;
    }
    
   SIM_WritingUnit_DoWrite = true;

}

// Wurde geschrieben oder Tag entfernt, Writing zurücksetzen
else if (!SIM_WritingUnit_IsDetecting || SIM_WritingUnit_WriteOk)
{
    //SIM_WritingUnit_DMC_WT = "";
    SIM_WritingUnit_DoWrite = false;
}

// Speichern der Fertigmeldung des Schreibens
if ( SIM_WritingUnit_WriteOk)
    {
    SIM_WritingUnit_WriteDone = true;
    }
else if (!SIM_WritingUnit_IsDetecting || SIM_ReadingUnit_DMC_WT == PAR_Init_Value)
    {
    SIM_WritingUnit_WriteDone = false;
    }
    
#endregion</ScriptText>
