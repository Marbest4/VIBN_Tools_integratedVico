if (PLC_O_SwitchOn &amp;&amp; PLC_O_Speed &gt;= PARA_WorkingSpeed)
{
    SIM_Speed = (float)PLC_O_Speed;
    PLC_I_FlowMonitor1 = true;
    PLC_I_FlowMonitor2 = true;
    PLC_I_FlowMonitor3 = true;
    PLC_I_FlowMonitor4 = true;
    PLC_I_OperatingMessage = true;
}
else
{
    SIM_Speed = 0.0f;
    PLC_I_FlowMonitor1 = false;
    PLC_I_FlowMonitor2 = false;
    PLC_I_FlowMonitor3 = false;
    PLC_I_FlowMonitor4 = false;
    PLC_I_OperatingMessage = false;

}</ScriptText>
