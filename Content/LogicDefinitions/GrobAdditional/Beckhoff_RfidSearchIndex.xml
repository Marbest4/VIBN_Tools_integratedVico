// Suche im Array
(SIM_Index, SIM_OutLabel) = FindeBytePosition(RfidSignalArray, SIM_PalletNumber);

(int,string) FindeBytePosition(ushort[] array, int number)
{

    for (int i = 0; i &lt; array.Length; i++)
    {
        if (array[i] == number)
        {
            int foundIndex = i+1;
            return (foundIndex, PAR_Prefix1 + SIM_PalletNumber + PAR_Prefix2 + foundIndex.ToString() + PAR_Suffix);
        }
    }
    return (0,"NOT FOUND");
}</ScriptText>
