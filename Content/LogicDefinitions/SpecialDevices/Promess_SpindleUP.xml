// Ready
PLC_IN_Ready = !PLC_OUT_ProgramNumberStrobe &amp;&amp; !PLC_OUT_SerialNumberStrobe &amp;&amp; !PLC_OUT_CycleStart;








// Convert 8 Bits to an integer value
private int GetIntFromBits(bool bit0 = false, bool bit1 = false, bool bit2 = false, bool bit3 = false, bool bit4 = false, bool bit5 = false, bool bit6 = false, bool bit7 = false)
{
    int value = 0;
    
    value += (bit0) ? 1 : 0;
    value += (bit1) ? 2 : 0;
    value += (bit2) ? 4 : 0;
    value += (bit3) ? 8 : 0;
    value += (bit4) ? 16 : 0;
    value += (bit5) ? 32 : 0;
    value += (bit6) ? 64 : 0;
    value += (bit7) ? 128 : 0;
    
    return value;
}</ScriptText>
