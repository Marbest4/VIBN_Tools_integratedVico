#region 8.3 Cycle Start
//============================================================================================================
// 8 . 3   C Y C L E   S T A R T
//============================================================================================================

// Get Program Numbers 1 to 10
string[] programNrPositionStrings = new string[10];
float[] programNrPositions = new float[10];
string[] tempArray = new string[10];

if(String.IsNullOrWhiteSpace(PAR_ProgramNrPositions_1_10))
{
    tempArray[0] = "0";
    tempArray[1] = "0";
    tempArray[2] = "0";
    tempArray[3] = "0";
    tempArray[4] = "0";
    tempArray[5] = "0";
    tempArray[6] = "0";
    tempArray[7] = "0";
    tempArray[8] = "0";
    tempArray[9] = "0";
}
else
{
    tempArray = PAR_ProgramNrPositions_1_10.Split(";");
}

if(tempArray.Length &gt; 10)
{
    tempArray = tempArray.Take(10).ToArray();
}
for (int i = 0; i &lt; tempArray.Length; i++)
{
    programNrPositionStrings[i] = tempArray[i];
}
for (int i = tempArray.Length; i &lt; 10; i++)
{
    programNrPositionStrings[i] = "0";
}

programNrPositions[0] = float.TryParse(programNrPositionStrings[0], out programNrPositions[0]) ? float.Parse(programNrPositionStrings[0]) : 0f;
programNrPositions[1] = float.TryParse(programNrPositionStrings[1], out programNrPositions[1]) ? float.Parse(programNrPositionStrings[1]) : 0f;
programNrPositions[2] = float.TryParse(programNrPositionStrings[2], out programNrPositions[2]) ? float.Parse(programNrPositionStrings[2]) : 0f;
programNrPositions[3] = float.TryParse(programNrPositionStrings[3], out programNrPositions[3]) ? float.Parse(programNrPositionStrings[3]) : 0f;
programNrPositions[4] = float.TryParse(programNrPositionStrings[4], out programNrPositions[4]) ? float.Parse(programNrPositionStrings[4]) : 0f;
programNrPositions[5] = float.TryParse(programNrPositionStrings[5], out programNrPositions[5]) ? float.Parse(programNrPositionStrings[5]) : 0f;
programNrPositions[6] = float.TryParse(programNrPositionStrings[6], out programNrPositions[6]) ? float.Parse(programNrPositionStrings[6]) : 0f;
programNrPositions[7] = float.TryParse(programNrPositionStrings[7], out programNrPositions[7]) ? float.Parse(programNrPositionStrings[7]) : 0f;
programNrPositions[8] = float.TryParse(programNrPositionStrings[8], out programNrPositions[8]) ? float.Parse(programNrPositionStrings[8]) : 0f;
programNrPositions[9] = float.TryParse(programNrPositionStrings[9], out programNrPositions[9]) ? float.Parse(programNrPositionStrings[9]) : 0f;


/* The Ready and Cycle End outputs are both set low with the recognition of the Cycle Start input. 
There will be a slight delay (≈100ms) from the time the Cycle Start is set high until the event is recognized and the Cycle End and Ready outputs are set low.*/
if (PLC_OUT_CycleStart) 
{

    PLC_IN_Pass = false;
    PLC_IN_Fail = false;
    PLC_IN_CycleEnd = false;
    
    _timer_100ms_CycleStart += SceneObject.DeltaTime;
    if(_timer_100ms_CycleStart &gt;= 0.1f)
    {

        // Set target position depending on program number
        switch (_programNumber)
        {
            case 1:
                SIM_TargetPosition = programNrPositions[0];
                break;
            case 2:
                SIM_TargetPosition = programNrPositions[1];
                break;
            case 3:
                SIM_TargetPosition = programNrPositions[2];
                break;
            case 4:
                SIM_TargetPosition = programNrPositions[3];
                break;
            case 5:
                SIM_TargetPosition = programNrPositions[4];
                break;
            case 6:
                SIM_TargetPosition = programNrPositions[5];
                break;
            case 7:
                SIM_TargetPosition = programNrPositions[6];
                break;
            case 8:
                SIM_TargetPosition = programNrPositions[7];
                break;
            case 9:
                SIM_TargetPosition = programNrPositions[8];
                break;
            case 10:
                SIM_TargetPosition = programNrPositions[9];
                break;
        }
        
        SIM_Velocity = PAR_Velocity;
        
        
        // Target Position Reached
        if((SIM_ActualPosition == programNrPositions[0] &amp;&amp; _programNumber == 1) || 
           (SIM_ActualPosition == programNrPositions[1] &amp;&amp; _programNumber == 2) ||
           (SIM_ActualPosition == programNrPositions[2] &amp;&amp; _programNumber == 3) ||
           (SIM_ActualPosition == programNrPositions[3] &amp;&amp; _programNumber == 4) ||
           (SIM_ActualPosition == programNrPositions[4] &amp;&amp; _programNumber == 5) ||
           (SIM_ActualPosition == programNrPositions[5] &amp;&amp; _programNumber == 6) ||
           (SIM_ActualPosition == programNrPositions[6] &amp;&amp; _programNumber == 7) ||
           (SIM_ActualPosition == programNrPositions[7] &amp;&amp; _programNumber == 8) ||
           (SIM_ActualPosition == programNrPositions[8] &amp;&amp; _programNumber == 9) ||
           (SIM_ActualPosition == programNrPositions[9] &amp;&amp; _programNumber == 10))
        {
            PLC_IN_CycleEnd = true;
            PLC_IN_CycleStartRelease = true;
            
            PLC_IN_Pass = !SIM_Result_NOK;
            PLC_IN_Fail = SIM_Result_NOK;
        }
    }    
}
else
{
    PLC_IN_CycleStartRelease = false;
    _timer_100ms_CycleStart = 0f;
}

