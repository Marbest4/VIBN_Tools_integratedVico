<LogicDefinition V="001" xsi:type="CSharpLogicDefinition" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Guid="2efa3a3a-6e49-44bb-a406-42eca7abf97c" LogicName="IPG_LaserPicker" LogicProvider="fe4a121e-169b-4fb0-8004-e2e53c268b26">
	<ScriptText>#load "reference"
using System.Threading;

//No_Error/Warnings-Bits setzen
if(PLC_OUT_Reset)
	NoErrors();

//StatusWord2 = ControlWord2
PLC_IN_ProgramNumber = PLC_OUT_ProgramNumber;
 
//Betriebsart, Service Modus notwendig?
PLC_IN_FB_Manual_Mode = PLC_OUT_Manual_Mode;
PLC_IN_FB_Automatic_Mode = !PLC_OUT_Manual_Mode; //wenn nicht hand, dann automatik?

//Strom an/aus
PLC_IN_Power_Supply_On = PLC_OUT_Power_Supply_On;

PLC_IN_With_Laser = !PLC_OUT_No_Laser;
PLC_IN_With_Force = !PLC_OUT_No_Force;
PLC_IN_With_Compensation = !PLC_OUT_No_Compensation;
PLC_IN_With_Wobble = !PLC_OUT_No_Wobble;
if(PLC_OUT_Fumator_Start)
{
    PLC_IN_Fumator_Working = true;
}
else if(PLC_OUT_Fumator_Stop)
{
    PLC_IN_Fumator_Working = false;
}

//Achse referenzieren
PLC_IN_Seam_Drive_Referenced = PLC_OUT_Seam_Drive_Referencing;

//Fahrt zur Schutzglaswechselposition
PLC_IN_Seam_Drive_In_PGCP = PLC_OUT_Seam_Drive_To_PGCP;

//Fahrt zur Startposition
//PLC_IN_Seam_Drive_In_Start_Pos = PLC_OUT_Seam_Drive_To_Start_Pos;
if(PLC_OUT_Seam_Drive_To_Start_Pos)
{
    PLC_IN_Seam_Drive_In_Start_Pos = true;
}
//Nahtantrieb in Mittelpos
PLC_IN_Seam_Drive_in_Mid_Pos = PLC_OUT_Seam_Drive_To_Mid_Pos;

//Nahtantrieb in Mittelpos
PLC_IN_Seam_Drive_in_End_Pos = PLC_OUT_Seam_Drive_To_End_Pos;



//Vorhub öffnen
if(PLC_OUT_PS_Open)
{
	PLC_IN_PS_Is_Open = true;
}

//Arbeitshub öffnen
if(PLC_OUT_WS_Open)
{
	PLC_IN_WS_Is_Open = true;
	PLC_IN_WS_Is_Close = false;
}

//Arbeitshub schließen
if(PLC_OUT_WS_closed)
{
	PLC_IN_WS_Is_Close = true;
	PLC_IN_WS_Is_Open = false;
}

//Clean Sequence
if((PLC_OUT_Initial_Pos_Clean_Upp | PLC_OUT_Initial_Pos_clean_Lpp) &amp;&amp; PLC_OUT_Cleansequence_Start)
{
		PLC_IN_Clean_Done = true;
}

//Sequence Start
if(PLC_OUT_Sequence_Start_1 | PLC_OUT_Sequence_Start_2)
{
	PLC_IN_Welding_Cycle_Active = true;
	PLC_IN_Program_Finish = true;
	PLC_IN_Quality_Monitor_Data_ready = true;
}
else
{
	 PLC_IN_Welding_Cycle_Active = false;
	 PLC_IN_Program_Finish = false;
}

if(PLC_OUT_setProgramNumber)
{
	PLC_IN_ProgramNrSelected = true;
}


//evtl nur bei zange nicht bei picker?

//open gun
if(PLC_OUT_ServoTeachUp)
{

}

//close gun
if(PLC_OUT_ServoTeachDown)
{

}

//to do beim testen:
//compensation?
//Servo Teach Up?
//clean done zurücksetzen


//Hilfsmethoden
void NoErrors()
{
	PLC_IN_No_Errors = true;
	PLC_IN_No_Laser_Errors = true;
	PLC_IN_No_Laser_Warnings = true;
	PLC_IN_No_LSS_Errors = true;
	PLC_IN_No_LSS_Warnings = true;
	PLC_IN_No_Protection_Glass_Error = true;
	PLC_IN_No_Protection_Glass_Warning = true;
	PLC_IN_No_Chiller_Errors = true;
	PLC_IN_No_Chiller_Warnings = true;
	PLC_IN_No_Geometry_Check_Errors = true;
	PLC_IN_No_Geometry_Check_Warnings = true;
	PLC_IN_No_Process_Monitor_Errors = true;
	PLC_IN_No_Process_Monitor_Warnings = true;
	PLC_IN_No_Fumator_Errors = true;
	PLC_IN_No_Fumator_Warnings = true;
	PLC_IN_No_Quality_Monitor_Error = true;
	PLC_IN_No_Quality_Monitor_Warnings = true;
	PLC_IN_Clean_Error = false;
	PLC_IN_GasSensorUppOK = true;
	PLC_IN_GasSensorIppOK = true;
	PLC_IN_CompensationInWorkPos = true;
	PLC_IN_PPSensor1OK = true;
	PLC_IN_PPSensor2OK = true;
	
	//ready to clean
	PLC_IN_Clean_Station_Ready = true;
}</ScriptText>
